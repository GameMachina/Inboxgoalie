{
  "name": "inbox-goalie",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Inbox Goalie receiver-side ChatGPT/MCP plugin with Base-native USDC settlement.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "privy:create-operator": "tsx scripts/create-privy-operator.ts",
    "deploy:base-sepolia": "BASE_CHAIN_ID=84532 tsx scripts/deploy-inbox-goalie-contract.ts",
    "deploy:base-mainnet": "BASE_CHAIN_ID=8453 tsx scripts/deploy-inbox-goalie-contract.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@coinbase/cdp-sdk": "^1.55.0",
    "@modelcontextprotocol/sdk": "^1.20.2",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "solc": "0.8.24",
    "viem": "^2.37.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
