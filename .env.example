PORT=3000
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/inbox_goalie

# Sender funding provider. Privy can present/route fiat funding providers in the sender UI.
PAYMENT_PROVIDER=coinbase
PLATFORM_FEE_BPS=2000

# Privy infrastructure. Never commit the real app secret.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_OPERATOR_WALLET_ID=t8te9v1lqwd00piyfotynn56
PRIVY_OPERATOR_WALLET_ADDRESS=0x84f461357d9ed06Ab361B3337D557d78d9b6A3Be
# Set true only if gas sponsorship is configured for this Privy app.
PRIVY_SPONSOR_GAS=false

# Base network. Start on Base Sepolia for contract development.
BASE_CHAIN_ID=84532
BASE_RPC_URL=https://sepolia.base.org
USDC_CONTRACT_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
INBOX_GOALIE_PAYMENT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
INBOX_GOALIE_TREASURY_ADDRESS=0xa5b02d50dd4d233fb105875dbac929d30720f2ea

# Coinbase can remain an underlying fiat onramp while Privy owns the wallet UX/infrastructure.
# These are only needed while the current server-side Coinbase payment adapter is enabled.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
COINBASE_WEBHOOK_SECRET=
COINBASE_ONRAMP_SANDBOX=true
COINBASE_ONRAMP_DOMAIN=

# Protects the manual Sepolia verification endpoint when PAYMENT_PROVIDER is not mock.
PAYMENT_VERIFICATION_SECRET=

# Optional provider switch for local/test development
# PAYMENT_PROVIDER=mock
