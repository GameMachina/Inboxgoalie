PORT=3000
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/inbox_goalie

# Payment provider
PAYMENT_PROVIDER=coinbase
PLATFORM_FEE_BPS=2000

# Base network. Start on Base Sepolia for contract development.
BASE_CHAIN_ID=84532
BASE_RPC_URL=https://sepolia.base.org
USDC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
INBOX_GOALIE_PAYMENT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
INBOX_GOALIE_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
SETTLEMENT_OPERATOR_PRIVATE_KEY=

# Coinbase Developer Platform server credentials
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
COINBASE_WEBHOOK_SECRET=
COINBASE_ONRAMP_SANDBOX=true

# For production Headless Onramp web checkout
COINBASE_ONRAMP_DOMAIN=

# Optional provider switch for local/test development
# PAYMENT_PROVIDER=mock
